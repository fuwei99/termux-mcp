// ============================================================
// Termux 守护进程表  ——  复制为 processes.jsonc 后按机器改
//     cp processes.jsonc.example processes.jsonc
// 由 supervisor.py 每 15s 巡一遍, 死了自动拉起。
// 从此重启服务 = 直接 pkill, 等几秒它自己回来。
//
// check 三种判活方式(可组合, 全满足才算活):
//   {"http": "http://127.0.0.1:8994/health"}   健康检查(最准)
//   {"port": 8996}                             端口在听
//   {"pgrep": "hub.py"}                        进程名匹配
// ============================================================
{
  "version": 1,
  "processes": [
    {
      "id": "termux-mcp",
      "name": "Termux MCP Server (本机能力, 端口 8996)",
      "enabled": true,
      "command": "bash run-mcp.sh",
      "cwd": ".",
      "check": { "http": "http://127.0.0.1:8996/health" },
      "grace": 12,
      "restartDelay": 2,
      "daysOfWeek": [1, 2, 3, 4, 5, 6, 7],
      "startMinutes": 0,
      "endMinutes": 1440,
      "maxConsecutiveStartFailures": 0    // 0 = 永不放弃, 一直重试
    },
    {
      // 母节点专属; 子节点把 enabled 改 false
      "id": "termux-hub",
      "name": "Termux MCP Hub 母节点 (转发所有设备, 端口 8994)",
      "enabled": true,
      "command": "bash run-hub.sh",
      "cwd": ".",
      "check": { "http": "http://127.0.0.1:8994/health" },
      "grace": 12,
      "restartDelay": 2,
      "maxConsecutiveStartFailures": 0
    },
    {
      // ngrok 最容易被 HyperOS 杀, 守护它才是这套东西的主要意义
      // 判活必须用 tunnel 而不是 {"port":4040}: agent 可能进程活着、4040 在听、
      // 但隧道早掉了(公网 ERR_NGROK_3200), 只看端口会误判成"还活着"而不重启。
      // tunnel 会去 4040 API 查 tunnels 列表, 空列表 = 空壳 = 判死。
      // 值可以写 true(有任意隧道即可)或域名片段(如 "chant-enunciate" 精确校验)。
      "id": "ngrok",
      "name": "ngrok 隧道 (按 config.jsonc 的 mode 暴露 hub 或 mcp 端口)",
      "enabled": true,
      "command": "bash run-ngrok.sh",
      "cwd": ".",
      "check": { "tunnel": true },
      "grace": 25,        // ngrok 建隧道慢, 多给点时间
      "restartDelay": 5,
      "maxConsecutiveStartFailures": 0
    },
    {
      // 可选: 持有 wake-lock, 防系统休眠掐网络
      // 判活串用脚本名而非 "sleep 3600" —— 后者太常见, 容易撞上别人的进程误判为活
      "id": "wake-lock",
      "name": "Termux Wake Lock 续命",
      "enabled": true,
      "command": "bash run-wakelock.sh",
      "cwd": ".",
      "check": { "pgrep": "run-wakelock.sh" },
      "grace": 5,
      "restartDelay": 2,
      "maxConsecutiveStartFailures": 0
    }
  ]
}
